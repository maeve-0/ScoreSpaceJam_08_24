[sub_resource type="Shader" id="Shader_31xee"]
code = "// NOTE: Shader automatically converted from Godot Engine 4.3.stable's StandardMaterial3D.

shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;

uniform vec4 albedo : source_color;
uniform sampler2D texture_albedo : source_color, filter_nearest, repeat_enable;
uniform sampler2D texture_lava : source_color, filter_nearest, repeat_enable;
uniform float grow : hint_range(-16.0, 16.0, 0.001);
uniform float point_size : hint_range(0.1, 128.0, 0.1);

uniform float roughness : hint_range(0.0, 1.0);
uniform sampler2D texture_metallic : hint_default_white, filter_nearest, repeat_enable;
uniform vec4 metallic_texture_channel;
uniform sampler2D texture_roughness : hint_roughness_r, filter_nearest, repeat_enable;

uniform float specular : hint_range(0.0, 1.0, 0.01);
uniform float metallic : hint_range(0.0, 1.0, 0.01);

uniform vec3 uv1_scale;
uniform vec3 uv1_offset;
uniform vec3 uv2_scale;
uniform vec3 uv2_offset;

uniform float player_z;

const int LAVA_STATE_NONE = 0;
const int LAVA_STATE_FLOOR = 1;
const int LAVA_STATE_LEFT_WALL = 2;
const int LAVA_STATE_RIGHT_WALL = 3;
const int LAVA_STATE_CEILING = 4;

uniform int lava_state;
uniform int lava_next_state;
uniform float lava_next_progress;

void vertex() {
	UV = UV * uv1_scale.xy + uv1_offset.xy;

	// Grow: Enabled
	VERTEX += NORMAL * grow;
	float vertex_added = VERTEX.x + VERTEX.y + VERTEX.z;
	if (player_z < VERTEX.z - 5.0) {
		float vertex_added = VERTEX.x + VERTEX.y + VERTEX.z;
		VERTEX += normalize(vec3(sin(TIME * 30.0 + vertex_added), cos(TIME * 11.0 + vertex_added), tan(TIME * 50.0 + vertex_added))) * 0.2;
	}

	bool lava_condition = (
		(lava_state == LAVA_STATE_FLOOR && NORMAL.y > 0.4) ||
		(lava_state == LAVA_STATE_LEFT_WALL && NORMAL.x > 0.4) ||
		(lava_state == LAVA_STATE_RIGHT_WALL && NORMAL.x < -0.4) ||
		(lava_state == LAVA_STATE_CEILING && NORMAL.y < -0.4)
	);

	if (lava_condition) {
		vec4 vert = MODEL_MATRIX * vec4(VERTEX, 1.0);
		vec3 displacement_axis;
		switch (lava_state) {
			case LAVA_STATE_FLOOR:
				displacement_axis = vec3(0.0, 1.0, 0.0);
				break;
			case LAVA_STATE_LEFT_WALL:
				displacement_axis = vec3(1.0, 0.0, 0.0);
				break;
			case LAVA_STATE_CEILING:
				displacement_axis = vec3(0.0, -1.0, 0.0);
				break;
			case LAVA_STATE_RIGHT_WALL:
				displacement_axis = vec3(-1.0, 0.0, 0.0);
				break;
		}
		VERTEX += (sin(TIME + vert.x + vert.y) * 0.1 + 0.1) * displacement_axis;
	}
}

void fragment() {
	vec2 base_uv = UV;

	vec4 albedo_tex;
	vec3 normal = (INV_VIEW_MATRIX * vec4(NORMAL.xyz, 0.0)).xyz;
	
	bool lava_condition = (
		(lava_state == LAVA_STATE_FLOOR && normal.y > 0.4) ||
		(lava_state == LAVA_STATE_LEFT_WALL && normal.x > 0.4) ||
		(lava_state == LAVA_STATE_RIGHT_WALL && normal.x < -0.4) ||
		(lava_state == LAVA_STATE_CEILING && normal.y < -0.4)
	);
	
	bool lava_next_condition = (
		(lava_next_state == LAVA_STATE_FLOOR && normal.y > 0.4) ||
		(lava_next_state == LAVA_STATE_LEFT_WALL && normal.x > 0.4) ||
		(lava_next_state == LAVA_STATE_RIGHT_WALL && normal.x < -0.4) ||
		(lava_next_state == LAVA_STATE_CEILING && normal.y < -0.4)
	);
	
	if (lava_condition) {
		ALBEDO = texture(texture_lava, base_uv).rgb;
	}
	else {
		albedo_tex = texture(texture_albedo, base_uv);
		if (UV.x > 0.25) {
			ALBEDO = vec3(0.6, 0.6, 1.0) * albedo_tex.rgb;
		}
		else {
			ALBEDO = albedo.rgb * albedo_tex.rgb;
		}
	}
	
	if (!lava_condition && lava_next_condition) {
		EMISSION.r = 0.5 + lava_next_progress * 0.5;
		EMISSION.g = lava_next_progress * 0.7;
		EMISSION.b = lava_next_progress * 0.7;
	}

	float metallic_tex = dot(texture(texture_metallic, base_uv), metallic_texture_channel);
	METALLIC = metallic_tex * metallic;
	SPECULAR = specular;

	vec4 roughness_texture_channel = vec4(1.0, 0.0, 0.0, 0.0);
	float roughness_tex = dot(texture(texture_roughness, base_uv), roughness_texture_channel);
	ROUGHNESS = roughness_tex * roughness;
}
"

[resource]
render_priority = 0
shader = SubResource("Shader_31xee")
shader_parameter/albedo = Color(1, 1, 1, 1)
shader_parameter/grow = 0.0
shader_parameter/point_size = 1.0
shader_parameter/roughness = 1.0
shader_parameter/metallic_texture_channel = null
shader_parameter/specular = 0.5
shader_parameter/metallic = 0.0
shader_parameter/uv1_scale = Vector3(1, 1, 1)
shader_parameter/uv1_offset = Vector3(0, 0, 0)
shader_parameter/uv2_scale = Vector3(1, 1, 1)
shader_parameter/uv2_offset = Vector3(0, 0, 0)
shader_parameter/player_z = null
shader_parameter/lava_state = null
shader_parameter/lava_next_state = null
shader_parameter/lava_next_progress = null
shader_parameter/texture_albedo = ExtResource("1_i2pod")
shader_parameter/texture_lava = ExtResource("2_nshnj")
